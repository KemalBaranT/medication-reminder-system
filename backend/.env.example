DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilac_takip?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
# Sessiz yenileme (refresh token) kaydinin gecerlilik suresi (gun)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PORT=3000

# Firebase Admin SDK (proje ayarlari > servis hesabi > yeni ozel anahtar)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gecikme (kritik) kademesinin esigi (dakika): planlanan saatten bu kadar sonra
# hala uygulanmamis doz "kacirildi" yapilir ve bashemsireye kritik uyari gider.
# Degistirilirse mobil (doseAlertPolicy.ts) ve web (doseAlerts.ts) esikleri de guncellenmeli.
ESCALATION_MINUTES=30
