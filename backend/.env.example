DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilac_takip?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=3000

# Firebase Admin SDK (proje ayarlari > servis hesabi > yeni ozel anahtar)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Bildirim eskalasyon suresi (dakika) - bu sure icinde uygulanmayan ilac ust hemsireye bildirilir
ESCALATION_MINUTES=15
